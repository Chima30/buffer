# Copy to .env.local and fill in. Never commit .env.local.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.

# ---- NEAR (testnet only for the MVP) ----
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
BUFFER_CONTRACT_ID=<your-contract>.testnet
# Circle testnet USDC (from developers.circle.com/stablecoins/usdc-contract-addresses).
# Do NOT use near-api-js's built-in testnet USDC preset: it points to usdc.fakes.testnet.
USDC_TOKEN_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
OWNER_ACCOUNT_ID=<owner>.testnet
CONTRIBUTOR_ACCOUNT_ID=<contributor>.testnet
VENDOR_ACCOUNT_ID=<vendor>.testnet
DEMO_CUSTOMER_ACCOUNT_ID=<customer>.testnet

# ---- NEAR AI Cloud (gateway only; do not use {slug}.completions.near.ai) ----
NEARAI_API_BASE=https://cloud-api.near.ai/v1
NEARAI_API_KEY=<server-only>
NEARAI_MODEL=<a Private / TEE model id from /v1/models>
NEARAI_FALLBACK_MODEL=<another Private model id>
# USD per 1M tokens for the chosen model, in micro-USD (1.05 USD -> 1050000)
NEARAI_INPUT_USD_MICROS_PER_M=<from the model catalog>
NEARAI_OUTPUT_USD_MICROS_PER_M=<from the model catalog>

# ---- OutLayer agent custody (testnet) ----
OUTLAYER_NETWORK=testnet
# Leave empty to use the SDK default; M0 checks which host answers.
OUTLAYER_API_BASE=
OUTLAYER_API_KEY=<server-only, wk_...>
OUTLAYER_WALLET_ID=<wallet id>
# Filled in by npm run outlayer:register
AGENT_ACCOUNT_ID=

# ---- NEAR Intents 1Click (dry quotes only) ----
ONECLICK_API_BASE=https://1click.chaindefuser.com
ONECLICK_JWT=
# Any valid mainnet NEAR account id; used only as the recipient field of dry quotes. No funds move.
ONECLICK_PREVIEW_ACCOUNT=<your-mainnet-account>.near

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public anon key>
SUPABASE_SERVICE_ROLE_KEY=<server-only>

# ---- App secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
RUNTIME_SECRET=<64 hex chars>
SESSION_SECRET=<64 hex chars>
